# Supabase (Settings → API in the Supabase dashboard)
# Also set these in Netlify (Site settings → Environment variables) for production builds.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — single-user personal deployment: auto-signs in with this account
# on load, skipping the login screen. RLS still applies (see supabase/README.md);
# this only removes the manual login step. Leave unset to keep the normal
# login/register flow (required for multi-user deployments).
VITE_JARVIS_AUTO_LOGIN_EMAIL=
VITE_JARVIS_AUTO_LOGIN_PASSWORD=
